<div class="setup-diagram" aria-label="Cueport setup flow">
  <div class="setup-card setup-card--start">
    <span class="setup-card-step">1</span>
    <span class="setup-card-copy">
      <strong>Get Cueport for Mac</strong>
      <small>Install the app on your Mac.</small>
    </span>
  </div>
  <span class="setup-line" aria-hidden="true"></span>
  <div class="setup-choice-panel">
    <p><span>2</span><strong>Choose a library</strong></p>
    <div class="setup-option">
      <span class="setup-card-step">A</span>
      <span class="setup-card-copy">
        <strong>Serato library</strong>
        <small>Use your <code>_Serato_</code> folder to build your library.</small>
      </span>
    </div>
    <div class="setup-option">
      <span class="setup-card-step">B</span>
      <span class="setup-card-copy">
        <strong>Cueport Direct</strong>
        <small>Build from your music files. <a href="https://github.com/djpardis/trailmix" target="_blank" rel="noopener noreferrer">trail mix</a> analyzes locally.</small>
      </span>
    </div>
  </div>
  <span class="setup-line" aria-hidden="true"></span>
  <div class="setup-card setup-card--finish">
    <span class="setup-card-step">3</span>
    <span class="setup-card-copy">
      <strong>Connect your iPhone</strong>
      <small>Sync selected collections to your phone.</small>
    </span>
  </div>
</div>
