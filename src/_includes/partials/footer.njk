<footer class="site-footer">
  <div class="container footer-grid">
    <p class="footer-social-list">
      <span class="footer-tune-in">Follow us <span class="footer-tune-arrow" aria-hidden="true">&rarr;</span></span>
      {% for item in site.social %}
        <a class="footer-social" href="{{ item.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ item.ariaLabel }}">{{ item.label }} <span aria-hidden="true">↗</span></a>
      {% endfor %}
    </p>
    <div class="footer-meta">
      <p class="footer-copyright">
        <span class="footer-copyright-full">© {{ "" | year }} {{ site.name }}. All rights reserved.</span>
        <span class="footer-copyright-short">© {{ site.name }}</span>
      </p>
    </div>
  </div>
</footer>
