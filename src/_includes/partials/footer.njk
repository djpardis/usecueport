<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-social-list" aria-label="Social links">
      <span class="footer-tune-in">Tune in to Cueport Radio <span class="footer-tune-arrow" aria-hidden="true">&rarr;</span></span>
      {% for item in site.social %}
        <a class="footer-social" href="{{ item.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ item.ariaLabel }}">
          {% if item.icon == "instagram" %}
            <svg viewBox="2 2 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" stroke="none"/>
            </svg>
          {% elif item.icon == "youtube" %}
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="none">
              <path fill="currentColor" d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          {% elif item.icon == "substack" %}
            <svg viewBox="-2 -2 28 28" aria-hidden="true" fill="currentColor" stroke="none">
              <path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/>
            </svg>
          {% endif %}
        </a>
      {% endfor %}
    </div>
    <div class="footer-meta">
      <p class="footer-copyright">
        <span class="footer-copyright-full">© {{ "" | year }} {{ site.name }}. All rights reserved.</span>
        <span class="footer-copyright-short">© {{ site.name }}</span>
      </p>
    </div>
  </div>
</footer>
