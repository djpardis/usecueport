<svg class="hero-waveform" viewBox="0 0 1600 600" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
  <g opacity="0.24">
    {# intro: airy high-freq content #}
    <rect x="0"    y="440" width="48" height="160" rx="3" fill="#9fc9ff"/>
    <rect x="64"   y="320" width="48" height="280" rx="3" fill="#7fb8ff"/>
    <rect x="128"  y="320" width="48" height="280" rx="3" fill="#7fb8ff"/>
    <rect x="192"  y="180" width="48" height="420" rx="3" fill="#7ab2ff"/>
    {# verse: mid-range content #}
    <rect x="256"  y="180" width="48" height="420" rx="3" fill="#7ab2ff"/>
    <rect x="320"  y="140" width="48" height="460" rx="3" fill="#7ab2ff"/>
    <rect x="384"  y="180" width="48" height="420" rx="3" fill="#7ab2ff"/>
    <rect x="448"  y="140" width="48" height="460" rx="3" fill="#4a95ff"/>
    {# chorus 1: bass-heavy drop #}
    <rect x="512"  y="40"  width="48" height="560" rx="3" fill="#1e5bd4"/>
    <rect x="576"  y="50"  width="48" height="550" rx="3" fill="#2778f5"/>
    <rect x="640"  y="10"  width="48" height="590" rx="3" fill="#1e5bd4"/>
    <rect x="704"  y="100" width="48" height="500" rx="3" fill="#2778f5"/>
    {# breakdown: sparse hi-freq #}
    <rect x="768"  y="320" width="48" height="280" rx="3" fill="#9fc9ff"/>
    <rect x="832"  y="280" width="48" height="320" rx="3" fill="#7fb8ff"/>
    <rect x="896"  y="240" width="48" height="360" rx="3" fill="#7fb8ff"/>
    {# build: mids returning #}
    <rect x="960"  y="140" width="48" height="460" rx="3" fill="#7ab2ff"/>
    <rect x="1024" y="80"  width="48" height="520" rx="3" fill="#4a95ff"/>
    <rect x="1088" y="40"  width="48" height="560" rx="3" fill="#2778f5"/>
    {# chorus 2: biggest drop, deepest bass #}
    <rect x="1152" y="10"  width="48" height="590" rx="3" fill="#1e5bd4"/>
    <rect x="1216" y="30"  width="48" height="570" rx="3" fill="#1e5bd4"/>
    <rect x="1280" y="0"   width="48" height="600" rx="3" fill="#1e5bd4"/>
    <rect x="1344" y="50"  width="48" height="550" rx="3" fill="#2778f5"/>
    {# outro: thinning out #}
    <rect x="1408" y="180" width="48" height="420" rx="3" fill="#7ab2ff"/>
    <rect x="1472" y="320" width="48" height="280" rx="3" fill="#7fb8ff"/>
    <rect x="1536" y="400" width="48" height="200" rx="3" fill="#9fc9ff"/>
  </g>
</svg>
