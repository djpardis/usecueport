<header class="site-header">
  <div class="container header-inner">
    <a class="logo-lockup" href="/" aria-label="{{ site.name }}">
      <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <rect x="0" y="19" width="5" height="13" fill="currentColor" opacity="0.55"/>
        <rect x="12" y="5" width="5" height="27" fill="currentColor" opacity="0.55"/>
        <rect x="19" y="13" width="5" height="19" fill="currentColor" opacity="0.55"/>
        <rect x="26.5" y="8" width="5" height="24" fill="currentColor" opacity="0.55"/>
        <rect x="5.2" y="0" width="5.6" height="5.6" fill="currentColor"/>
        <rect x="7" y="5.4" width="2" height="26.6" fill="currentColor"/>
      </svg>
      <span class="brand-title">{{ site.name }}</span>
    </a>
    <p class="header-dateline"><time class="header-date-long" data-dateline="long"></time><time class="header-date-short" data-dateline="short"></time></p>
    <script>
      document.querySelectorAll("[data-dateline]").forEach(function (el) {
        var now = new Date();
        var long = el.dataset.dateline === "long";
        el.dateTime = now.toLocaleDateString("en-CA");
        el.textContent = now.toLocaleDateString("en-US", long
          ? { weekday: "long", month: "long", day: "numeric", year: "numeric" }
          : { month: "short", day: "numeric", year: "numeric" });
      });
    </script>
    <nav class="site-nav" aria-label="Primary">
      <ul>
        {% for item in site.nav %}
          <li>
            <a href="{{ item.href }}"{% if item.icon == "radio" %} class="nav-radio"{% endif %} aria-label="{{ item.label }}" title="{{ item.label }}"{% if item.external %} target="_blank" rel="noopener noreferrer"{% endif %}{% if page.url == item.href %} aria-current="page"{% endif %}>
              <span class="nav-icon" aria-hidden="true">
                {% if item.icon == "features" %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="square" stroke-linejoin="miter"><rect x="4" y="4" width="6" height="6"/><rect x="14" y="4" width="6" height="6"/><rect x="9" y="14" width="6" height="6"/><path d="M10 7h4"/><path d="M12 10v4"/></svg>
                {% elif item.icon == "signup" %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/></svg>
                {% elif item.icon == "download" %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
                {% elif item.icon == "radio" %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="square" stroke-linejoin="miter"><path d="M4 9h17v11H4z"/><path d="M7 9l10-6"/><path d="M7 13h5"/><path d="M7 16h5"/><circle cx="16.5" cy="14.5" r="2.75"/></svg>
                {% elif item.icon == "support" %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="square" stroke-linejoin="miter"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 0 1 5 0c0 1.6-2.5 2-2.5 4"/><path d="M12 17h.01"/></svg>
                {% endif %}
              </span>
              <span class="nav-label">{{ item.label }}</span>
              {% if item.icon == "radio" %}
                <span class="nav-short" aria-hidden="true">Radio</span>
              {% endif %}
              {% if item.external %}
                <span class="nav-external" aria-hidden="true">
                  <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter">
                    <path d="M4 2h6v6"/>
                    <path d="M10 2 3 9"/>
                  </svg>
                </span>
              {% endif %}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>
