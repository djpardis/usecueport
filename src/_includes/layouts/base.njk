<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }} | {{ site.subtitle }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    <meta name="theme-color" content="#d9d0c3" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ title or site.name }}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:title" content="{{ title or site.name }}" />
    <meta name="twitter:description" content="{{ description or site.description }}" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "{{ site.name }}",
        "applicationCategory": "MultimediaApplication",
        "operatingSystem": "macOS, iOS, Windows, Android",
        "description": "{{ description or site.description }}",
        "url": "{{ site.url }}",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
      }
    </script>

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/assets/css/style.css" />
    <script src="/assets/js/navigation.js?v={{ site.version }}" defer></script>
  </head>
  <body>
    {% include "partials/header.njk" %}
    <script>
      (() => {
        const header = document.querySelector(".site-header");
        if (!header) return;

        let frame = 0;
        const syncHeaderLogo = () => {
          frame = 0;
          const y = window.scrollY || document.documentElement.scrollTop || 0;
          const allowAnimatedLogo = window.matchMedia("(min-width: 641px)").matches;
          header.classList.toggle("site-header--muted", allowAnimatedLogo && y > 12);
          header.classList.toggle("site-header--collapsed", allowAnimatedLogo && y > 96);
        };
        const scheduleHeaderLogo = () => {
          if (frame) return;
          frame = window.requestAnimationFrame(syncHeaderLogo);
        };

        window.addEventListener("scroll", scheduleHeaderLogo, { passive: true });
        window.addEventListener("wheel", scheduleHeaderLogo, { passive: true });
        window.addEventListener("touchmove", scheduleHeaderLogo, { passive: true });
        window.addEventListener("resize", syncHeaderLogo);
        syncHeaderLogo();
      })();
    </script>
    <main id="main"{% if homeMain %} class="home-main"{% elif viewportMain %} class="viewport-main"{% endif %}>
      {{ content | safe }}
    </main>
    {% include "partials/footer.njk" %}
  </body>
</html>
