<div class="container">
  <div class="page-head">
    <h1>How it works.</h1>
    <p class="lede">Start from a Serato library or music files on your computer. Send selected music to your phone, make edits on either device, and review changes before publishing them back.</p>
  </div>
  <div class="paper-cols">
    {%- for step in howItWorks %}
    <article class="paper-col">
      <h2 class="paper-head"><span class="paper-num" aria-hidden="true">{{ loop.index }}</span>{{ step.title }}</h2>
      <p class="paper-dek">{{ step.summary }}</p>
      {%- for item in step.items %}
      <p class="paper-item"><strong>{{ item.title }}</strong> {{ item.text | safe }}</p>
      {%- endfor %}
    </article>
    {%- endfor %}
  </div>

