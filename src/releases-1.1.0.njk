---
layout: layouts/base.njk
title: "Changelog"
description: "Cueport changelog for desktop and mobile versions."
permalink: /changelog/
viewportMain: true
---

<section class="container release-page" aria-labelledby="changelog-title">
  <div class="page-head">
    <h1 class="visually-hidden" id="changelog-title">Changelog</h1>
    <p class="lede">See what's new in each Cueport desktop and mobile release.</p>
  </div>
  <div class="release-anchor-target" id="{{ releases.currentAnchor }}" aria-hidden="true"></div>
  <div class="release-streams">
    {% for stream in releases.streams %}
      <section class="release-stream" id="{{ stream.id }}" aria-labelledby="{{ stream.id }}-heading">
        <header class="release-stream-head">
          <p class="paper-kicker">{{ stream.label }}</p>
          <h2 class="paper-head" id="{{ stream.id }}-heading">{{ stream.title }}</h2>
          <p class="paper-dek">{{ stream.summary }}</p>
          <nav class="release-version-list" aria-label="{{ stream.label }} versions">
            {% for entry in stream.entries %}
              <a href="#{{ entry.id }}">{{ entry.platformLabel }} {{ entry.linkLabel }}</a>
            {% endfor %}
          </nav>
        </header>
        {% for entry in stream.entries %}
          <article class="release-note" id="{{ entry.id }}">
            <p class="release-note-platform">{{ entry.platformLabel }}</p>
            <h3 class="release-note-title"><a class="paper-anchor" href="#{{ entry.id }}">{{ entry.linkLabel }}</a></h3>
            <p class="paper-dek"><strong>{{ entry.title }}</strong> {{ entry.summary }}</p>
            {% for item in entry.items %}
              {% if item.trailMixAnalysis %}
                <p class="paper-item"><strong>{{ item.title }}{% if item.badge %} <span class="status-tag">{{ item.badge }}</span>.{% endif %}</strong> {{ item.textBeforeTrailMix }} <a href="{{ site.trailMix.url }}" target="_blank" rel="noopener noreferrer">trail mix {{ site.trailMix.version }}</a>{{ item.textAfterTrailMix }}</p>
              {% else %}
                <p class="paper-item"><strong>{{ item.title }}{% if item.badge %} <span class="status-tag">{{ item.badge }}</span>.{% endif %}</strong> {{ item.text | safe }}</p>
              {% endif %}
            {% endfor %}
          </article>
        {% endfor %}
      </section>
    {% endfor %}
  </div>
</section>
