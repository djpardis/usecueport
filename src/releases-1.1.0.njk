          </div>
        </dl>
      </div>
    </div>
  </article>
</section>

<script>
  (() => {
    const root = document.querySelector("[data-release-tabs]");
    if (!root) return;
    const tabs = Array.from(root.querySelectorAll("[role='tab']"));
    const panels = Array.from(root.querySelectorAll("[role='tabpanel']"));

    function activate(nextTab, updateHash = true) {
      tabs.forEach((tab) => {
        const selected = tab === nextTab;
        tab.classList.toggle("is-active", selected);
        tab.setAttribute("aria-selected", selected ? "true" : "false");
        tab.tabIndex = selected ? 0 : -1;
      });
      panels.forEach((panel) => {
        const selected = panel.id === nextTab.getAttribute("aria-controls");
        panel.classList.toggle("is-active", selected);
        panel.hidden = !selected;
      });
      if (updateHash) history.replaceState(null, "", `#${nextTab.getAttribute("aria-controls")}`);
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", (event) => {
        const keys = ["ArrowLeft", "ArrowRight", "Home", "End"];
        if (!keys.includes(event.key)) return;
        event.preventDefault();
        let nextIndex = index;
        if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
        if (event.key === "Home") nextIndex = 0;
        if (event.key === "End") nextIndex = tabs.length - 1;
        tabs[nextIndex].focus();
        activate(tabs[nextIndex]);
      });
    });

    const initial = tabs.find((tab) => `#${tab.getAttribute("aria-controls")}` === window.location.hash);
    if (initial) activate(initial, false);
  })();
</script>
