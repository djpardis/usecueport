<section class="container release-notes" data-release-tabs>
  <div class="release-tablist" role="tablist" aria-label="Cueport release notes">
    <button class="release-tab is-active" id="release-tab-desktop" type="button" role="tab" aria-selected="true" aria-controls="desktop">
