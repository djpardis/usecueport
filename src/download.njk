---
layout: layouts/base.njk
title: "Download"
description: "Request a Cueport download link for Mac."
permalink: /download/
viewportMain: true
---

<div class="container download-page">
  <div class="page-head download-desktop-head">
    <h1>Download</h1>
    <p class="lede">Cueport is rolling out with free access to DJs. Enter your details and we will email you the download link when it ships.</p>
  </div>

  <div class="page-head download-mobile-head">
    <h1>Download</h1>
    <p class="lede">Install Cueport and pick your library setup before you start on Mac.</p>
  </div>

  <section class="download-intro" aria-label="Cueport setup">
    <div class="setup-tree download-setup-tree">
      <div class="tree-root">
        <span class="tree-num">1</span>
        <div>
          <h2>Start on your Mac</h2>
          <p>Install Cueport and pick your library setup.</p>
          <a class="tree-download-link" href="/download/form/" aria-label="Go to download form">
            <span>Download</span>
            <span class="tree-download-icon" aria-hidden="true">
              <svg class="icon-apple" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
              </svg>
              <span class="icon-divider"></span>
              <svg class="icon-download" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <path d="M7 10l5 5 5-5"/>
                <path d="M12 15V3"/>
              </svg>
            </span>
          </a>
        </div>
      </div>
      <div class="tree-branches">
        <div class="tree-branch">
          <span class="tree-label">A</span>
          <div>
            <h2>Serato library</h2>
            <p>Use your <code>_Serato_</code> folder to build your Cueport library.</p>
          </div>
        </div>
        <div class="tree-or">OR</div>
        <div class="tree-branch tree-branch--direct">
          <span class="tree-label">B</span>
          <div>
            <h2>Cueport Direct</h2>
            <p>Build your Cueport library directly from your music files.</p>
          </div>
        </div>
      </div>
      <div class="tree-root">
        <span class="tree-num">2</span>
        <div>
          <h2>Connect your iPhone</h2>
          <p>Sync selected collections to your phone.</p>
          <p class="tree-store-note">Available separately on the App Store.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="download-form-panel download-form-panel--desktop" id="request-download">
    {% include "partials/access-form.njk" %}
  </section>
</div>
