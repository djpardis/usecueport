---
layout: layouts/base.njk
title: "Download"
description: "Request a Cueport download link and choose either Serato library setup or Cueport Direct folder setup."
permalink: /download/
viewportMain: true
---

<div class="container">
  <div class="page-head">
    <h1>Download</h1>
    <p class="lede">Cueport is rolling out with free access to DJs. Request a Mac download link below.</p>
  </div>
  <div class="access-layout">
    <form class="access-form" data-access-form method="POST" action="{{ site.forms.access.action }}">
      <div class="form-stack">
        <div class="form-row">
          <label>
            Name
            <input name="full_name" autocomplete="name" required>
          </label>
          <label>
            DJ name
            <input name="DJ_name" autocomplete="organization">
          </label>
        </div>

        <label>
          Email
          <input name="email" type="email" autocomplete="email" required>
        </label>

        <label>
          Socials or website
          <input name="social_or_site" placeholder="@name or https://...">
        </label>

        <label>
          Main DJ software
          <select name="DJ_software" required>
            <option value="">Choose one</option>
            <option>Serato DJ Pro</option>
            <option>Rekordbox</option>
            <option>Traktor</option>
            <option>VirtualDJ</option>
            <option>Engine DJ</option>
            <option>Mixxx</option>
            <option>Other</option>
          </select>
        </label>

        <label>
          Library size
          <select name="library_size">
            <option value="">Choose one</option>
            <option>Under 500 tracks</option>
            <option>500 to 2,000 tracks</option>
            <option>2,000 to 10,000 tracks</option>
            <option>10,000+ tracks</option>
          </select>
        </label>
      </div>

      <input name="website" tabindex="-1" autocomplete="off" hidden>

      <button class="btn" type="submit">Submit</button>
      <p class="form-status" data-access-form-status role="status" aria-live="polite"></p>
    </form>

    <aside class="access-note">
      <div class="setup-tree">
        <div class="tree-root">
          <span class="tree-num">1</span>
          <div>
            <h2>Start on Mac</h2>
            <p>Install Cueport and choose how it reads your library.</p>
          </div>
        </div>
        <div class="tree-branches">
          <div class="tree-branch">
            <span class="tree-label">A</span>
            <div>
              <h2>Serato library</h2>
              <p>Link your local <code>_Serato_</code> folder.</p>
            </div>
          </div>
          <div class="tree-branch">
            <span class="tree-label">B</span>
            <div>
              <h2>Cueport Direct</h2>
              <p>Open a music folder for local analysis with <strong><a href="https://trailmix.tools" target="_blank" rel="noopener noreferrer">trail mix</a></strong>.</p>
            </div>
          </div>
        </div>
        <div class="tree-root">
          <span class="tree-num">2</span>
          <div>
            <h2>Connect your iPhone</h2>
            <p>Pair the companion app over your local network and send selected collections.</p>
            <p class="tree-store-note">Available separately on the App Store.</p>
          </div>
        </div>
      </div>
    </aside>
  </div>
</div>

<script>
  const accessForm = document.querySelector("[data-access-form]");
  const accessStatus = document.querySelector("[data-access-form-status]");

  accessForm?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!accessForm.reportValidity()) {
      return;
    }

    accessStatus.textContent = "Sending...";

    try {
      const response = await fetch(accessForm.action, {
        method: "POST",
        body: new FormData(accessForm)
      });

      if (response.ok) {
        accessForm.reset();
        accessStatus.textContent = "Thanks. We got your request and we'll get in touch by email.";
        return;
      }

      const body = await response.json().catch(() => ({}));
      accessStatus.textContent = body.error || "Something went wrong. Please try again.";
    } catch {
      accessStatus.textContent = "Could not reach the form service. Please try again.";
    }
  });
</script>
