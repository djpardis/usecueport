---
layout: layouts/base.njk
title: ""
description: "Do you own your music and want to play it anywhere? Cueport reads Serato or builds a local library from music files, syncs your phone over your local network, and lets you add cues and edit sets on either device."
homeMain: true
---

<section class="home-hero">
  <div class="container home-hero-inner">
    <div class="home-copy">
      <p class="home-eyebrow">A local-first phone + desktop app</p>
      <h2 class="home-title">{{ site.subtitle }}.</h2>
      <div class="home-intro">
        <p class="home-sub"><strong class="home-question-inline">{{ site.homeQuestion }}</strong> {{ site.homeDescription }}</p>
      </div>
      <div class="home-actions">
        <a class="app-btn app-btn--primary" href="{{ site.downloads.mac }}" aria-label="Request Cueport download link">
          <svg class="icon-stroke" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3v13"/>
            <path d="M7 11l5 5 5-5"/>
            <path d="M4 21h16"/>
          </svg>
          <span class="app-btn-text">Download link</span>
        </a>
      </div>
      <form class="mailing-list-form" data-mailing-list-form method="POST" action="{{ site.forms.mailingList.action }}">
        <label>
          Join the mailing list
          <span class="mailing-list-row">
            <input name="email" type="email" autocomplete="email" placeholder="Email address" required>
            <button class="btn" type="submit">Join</button>
          </span>
        </label>
        <input name="website" tabindex="-1" autocomplete="off" aria-hidden="true" hidden>
        <p class="form-status" data-mailing-list-status role="status" aria-live="polite"></p>
      </form>
    </div>
    <div class="home-art" aria-hidden="true">
      <img src="/assets/img/logo-transparent.svg" width="280" height="280" alt="" />
    </div>
  </div>
</section>

<script>
  const mailingListForm = document.querySelector("[data-mailing-list-form]");
  const mailingListStatus = document.querySelector("[data-mailing-list-status]");

  mailingListForm?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!mailingListForm.reportValidity()) {
      return;
    }

    mailingListStatus.textContent = "Joining...";

    try {
      const response = await fetch(mailingListForm.action, {
        method: "POST",
        body: new FormData(mailingListForm)
      });

      if (response.ok) {
        mailingListForm.reset();
        mailingListStatus.textContent = "Thanks. You're on the mailing list.";
        return;
      }

      const body = await response.json().catch(() => ({}));
      mailingListStatus.textContent = body.error || "Something went wrong. Please try again.";
    } catch {
      mailingListStatus.textContent = "Could not reach the form service. Please try again.";
    }
  });
</script>
